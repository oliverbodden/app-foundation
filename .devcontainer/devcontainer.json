{
  "name": "app-foundation",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000, 8081],
  "portsAttributes": {
    "3000": { "label": "Web (Next.js)", "onAutoForward": "openPreview" },
    "8081": { "label": "Expo / Metro" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "expo.vscode-expo-tools"]
    }
  }
}
