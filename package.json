{
  "name": "app-foundation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=@app/web",
    "mobile": "npm run start --workspace=@app/mobile",
    "mobile:tunnel": "npm run start --workspace=@app/mobile -- --tunnel",
    "build:web": "npm run build --workspace=@app/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
